<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImmeubleCad.Desktop.ExportDialog" Title="Exporter" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Format" FontWeight="SemiBold" />
    <ComboBox x:Name="Formats" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="Purpose" TextWrapping="Wrap" Opacity="0.7" MinHeight="36" />
    <TextBlock Text="Niveaux à inclure" FontWeight="SemiBold" />
    <ItemsControl x:Name="LevelBoxes" />
    <TextBlock Text="Réseaux à inclure" FontWeight="SemiBold" />
    <ItemsControl x:Name="NetworkBoxes" />
    <TextBlock Text="Unités" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Spacing="12"><RadioButton x:Name="Mm" Content="Millimètres" IsChecked="True" GroupName="u" /><RadioButton x:Name="M" Content="Mètres" GroupName="u" /></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="CancelBtn" Content="Annuler" IsCancel="True" />
      <Button x:Name="OkBtn" Content="Exporter…" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
