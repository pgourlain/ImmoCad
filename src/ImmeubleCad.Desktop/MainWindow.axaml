<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImmeubleCad.Desktop"
        x:Class="ImmeubleCad.Desktop.MainWindow" x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1280" Height="820" MinWidth="800" MinHeight="500">
  <Window.Styles>
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button.level">
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,3" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.level.current"><Setter Property="Background" Value="{DynamicResource SystemAccentColor}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="26" /></Style>
    <Style Selector="Border.bar"><Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Opacity" Value="0.65" /><Setter Property="FontSize" Value="11" /></Style>
  </Window.Styles>
  <DockPanel>
    <ContentControl x:Name="MenuHost" DockPanel.Dock="Top" />
    <!-- document tabs -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="8,4,8,0" IsVisible="{Binding HasDocument}">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabItem">
            <Border CornerRadius="6,6,0,0" Padding="10,5,4,5" Classes.active="{Binding IsActive}" Background="{DynamicResource SystemChromeMediumColor}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Padding="0" Background="Transparent" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SwitchTabCommand}" CommandParameter="{Binding Index}">
                  <TextBlock Text="{Binding Title}" FontWeight="{Binding IsActive, Converter={x:Static vm:Converters.BoldIf}}" />
                </Button>
                <TextBlock Text="●" IsVisible="{Binding IsDirty}" FontSize="9" VerticalAlignment="Center" Foreground="OrangeRed" />
                <Button Content="✕" Padding="4,0" FontSize="10" Background="Transparent" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding Index}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Classes="bar" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Hint}" Classes="caption" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- tool strip -->
    <Border DockPanel.Dock="Left" Classes="bar" Padding="8">
      <StackPanel>
        <ToggleButton Classes="tool" Content="↖" ToolTip.Tip="Sélection / déplacement" IsChecked="{Binding IsSelectTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Select" />
        <ToggleButton Classes="tool" Content="▭" ToolTip.Tip="Dessiner un mur" IsChecked="{Binding IsDrawTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="DrawWall" />
        <ToggleButton Classes="tool" Content="◎" ToolTip.Tip="Colonne (vue de dessus)" IsChecked="{Binding IsRiserTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Riser" />
        <ToggleButton Classes="tool" Content="╋" ToolTip.Tip="Tuyau" IsChecked="{Binding IsPipeTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="DrawPipe" />
        <ToggleButton Classes="tool" Content="⌷" ToolTip.Tip="Porte" IsChecked="{Binding IsDoorTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Door" />
        <ToggleButton Classes="tool" Content="⊟" ToolTip.Tip="Fenêtre" IsChecked="{Binding IsWindowTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Window" />
        <ToggleButton Classes="tool" Content="▢" ToolTip.Tip="Pièce (clic dans un espace fermé)" IsChecked="{Binding IsSpaceTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Space" />
        <ToggleButton Classes="tool" Content="№" ToolTip.Tip="Numéroter les caves" IsChecked="{Binding IsNumberTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="NumberCellars" />
        <ToggleButton Classes="tool" Content="⟷" ToolTip.Tip="Mesurer" IsChecked="{Binding IsMeasureTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Measure" />
        <ToggleButton Classes="tool" Content="⟋" ToolTip.Tip="Redresser les murs sélectionnés (aperçu en vert, Entrée applique)" IsChecked="{Binding IsStraightenTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Straighten" />
        <ToggleButton Classes="tool" Content="⌖" ToolTip.Tip="Aligner sur le niveau du dessous (par points)" IsChecked="{Binding IsAlignTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Align" />
        <Separator Margin="0,6" />
        <Button Classes="tool" Content="⤒" ToolTip.Tip="Déplacer la sélection à l'étage au-dessus (Ctrl+PgUp)" Command="{Binding MoveSelectionUpCommand}" />
        <Button Classes="tool" Content="⤓" ToolTip.Tip="Déplacer la sélection à l'étage en dessous (Ctrl+PgDn)" Command="{Binding MoveSelectionDownCommand}" />
        <Button Classes="tool" Content="⧉" ToolTip.Tip="Copier la sélection sur tous les niveaux" Command="{Binding CopySelectionToAllLevelsCommand}" />
        <Button Classes="tool" Content="✕" ToolTip.Tip="Supprimer la sélection (Suppr)" Command="{Binding DeleteSelectionCommand}" />
      </StackPanel>
    </Border>

    <!-- side panels -->
    <Border DockPanel.Dock="Left" Classes="bar" Width="270" Padding="8" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1,0,0,0">
      <TabControl>
        <TabItem Header="Palette">
          <DockPanel>
            <TextBox DockPanel.Dock="Top" Watermark="Rechercher…" Text="{Binding Search}" Margin="0,4,0,6" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Palette}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteItem">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,3" Padding="8,6"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectPaletteCommand}" CommandParameter="{Binding Id}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Glyph}" FontSize="20" Width="26" />
                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Category}" Classes="caption" /></StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Options">
          <ScrollViewer><StackPanel Spacing="6" Margin="0,6">
            <TextBlock Text="COLONNE" Classes="caption" />
            <ComboBox ItemsSource="{Binding RiserTemplates}" SelectedItem="{Binding RiserTemplate}" HorizontalAlignment="Stretch" />
            <ComboBox ItemsSource="{Binding NetworkTypes}" SelectedItem="{Binding RiserType}" HorizontalAlignment="Stretch" />
            <NumericUpDown Value="{Binding RiserDiameter}" Minimum="8" Maximum="200" FormatString="0 &quot;mm&quot;" />
            <NumericUpDown Value="{Binding RiserSpacing}" Minimum="50" Maximum="1000" FormatString="Entraxe 0 &quot;mm&quot;" />
            <CheckBox Content="Tout le bâtiment" IsChecked="{Binding RiserWholeBuilding}" />
            <Separator />
            <TextBlock Text="REDRESSER" Classes="caption" />
            <NumericUpDown Value="{Binding StraightenTolerance}" Minimum="0" Maximum="300" FormatString="Tolérance 0 &quot;mm&quot;" />
            <NumericUpDown Value="{Binding StraightenAngle}" Minimum="0" Maximum="20" FormatString="Angle 0&quot;°&quot;" />
            <Button Content="Rendre rectangulaire" Command="{Binding MakeRectangularCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Separator />
            <TextBlock Text="TUYAU" Classes="caption" />
            <ComboBox ItemsSource="{Binding NetworkTypes}" SelectedItem="{Binding PipeType}" HorizontalAlignment="Stretch" />
            <NumericUpDown Value="{Binding PipeDiameter}" Minimum="8" Maximum="200" FormatString="0 &quot;mm&quot;" />
            <NumericUpDown Value="{Binding PipeElevation}" Minimum="0" Maximum="6000" Increment="50" FormatString="Hauteur 0 &quot;mm&quot;" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Réseaux">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Networks}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NetworkItem">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4">
                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Type}" Classes="caption" /></StackPanel>
                    <Button Grid.Column="2" Content="{Binding Visible}" ContentTemplate="{x:Null}" Padding="6,2" ToolTip.Tip="Afficher / masquer"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleNetworkCommand}" CommandParameter="{Binding Id}" />
                    <Button Grid.Column="3" Content="{Binding Locked}" Padding="6,2" Margin="4,0,0,0" ToolTip.Tip="Verrouiller"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).LockNetworkCommand}" CommandParameter="{Binding Id}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Historique">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding HistoryRows}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,2" Background="Transparent"
                          Opacity="{Binding IsFuture, Converter={x:Static vm:Converters.DimIf}}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).JumpToCommand}" CommandParameter="{Binding Index}">
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding IsCurrent, Converter={x:Static vm:Converters.BoldIf}}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Espaces">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,6">
              <TextBlock Text="NUMÉROTATION DES CAVES" Classes="caption" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox Text="{Binding CellarPrefix}" /><NumericUpDown Grid.Column="1" Value="{Binding CellarStart}" Minimum="0" Width="100" /></Grid>
              <ComboBox ItemsSource="{Binding SpaceKinds}" SelectedItem="{Binding NewSpaceKind}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding SpaceItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpaceItem">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,2" Background="Transparent"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FocusSpaceCommand}" CommandParameter="{Binding Id}">
                      <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Kind}" Classes="caption" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Area}" VerticalAlignment="Center" Classes="caption" /></Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Propriétés">
          <StackPanel Spacing="6" Margin="0,6">
            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" />
            <TextBox Watermark="Libellé" Text="{Binding PropLabel}" />
            <NumericUpDown Value="{Binding PropHeight}" Minimum="0" Maximum="10000" Increment="50" FormatString="Hauteur 0 &quot;mm&quot; (0 = niveau)" />
            <NumericUpDown Value="{Binding PropThickness}" Minimum="0" Maximum="1000" Increment="10" FormatString="Épaisseur 0 &quot;mm&quot;" />
            <Button Content="Appliquer l'épaisseur" Command="{Binding ApplyThicknessCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Appliquer" Command="{Binding ApplyPropertiesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Border>

    <!-- level bar: scrolls, so 30+ levels fit -->
    <Border DockPanel.Dock="Right" Classes="bar" Width="132" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="NIVEAUX" Classes="caption" Margin="0,0,0,6" />
        <Button DockPanel.Dock="Bottom" Content="+ Niveau" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0" Command="{Binding AddLevelCommand}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LevelItem">
                <Button Classes="level" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Tooltip}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectLevelCommand}" CommandParameter="{Binding Id}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Ajouter un niveau au-dessus" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddLevelAboveCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem Header="Ajouter un niveau en dessous" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddLevelBelowCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem Header="Renommer…" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RenameLevelCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem Header="Altitude et hauteur…" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelGeometryCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem Header="Type : sous-sol / caves" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelKindCommand}" CommandParameter="{Binding BasementSpec}" />
                      <MenuItem Header="Type : rez-de-chaussée" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelKindCommand}" CommandParameter="{Binding GroundSpec}" />
                      <MenuItem Header="Type : étage courant" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelKindCommand}" CommandParameter="{Binding StandardSpec}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Altitude}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- view switch -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="12,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="↶" Command="{Binding UndoCommand}" ToolTip.Tip="Annuler" />
          <Button Content="↷" Command="{Binding RedoCommand}" ToolTip.Tip="Rétablir" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding SelectionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="caption" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Content="2D" Command="{Binding SetModeCommand}" CommandParameter="Plan" />
          <Button Content="Élévation" Command="{Binding ShowElevationCommand}" ToolTip.Tip="Vue de face du mur sélectionné" />
          <Button Content="3D" Command="{Binding SetModeCommand}" CommandParameter="Solid" />
          <Button Content="Filaire" Command="{Binding SetModeCommand}" CommandParameter="Wireframe" />
          <ToggleButton Content="Rayons X" IsChecked="{Binding XRay, Mode=OneWay}" Command="{Binding ToggleXRayCommand}" IsVisible="{Binding Is3D}" />
          <ToggleButton Content="Coupe" IsChecked="{Binding CutAbove, Mode=OneWay}" Command="{Binding ToggleCutCommand}" IsVisible="{Binding Is3D}" ToolTip.Tip="Masquer ce qui est au-dessus du niveau courant" />
          <Button Content="Niveaux" Command="{Binding CycleLevelFilterCommand}" IsVisible="{Binding Is3D}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Border x:Name="Welcome" ZIndex="10" IsVisible="{Binding ShowWelcome}" Background="{DynamicResource SystemRegionColor}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="360">
          <TextBlock Text="ImmeubleCad" FontSize="34" FontWeight="Light" />
          <TextBlock Text="Modélisez un immeuble à partir de ses plans, puis tracez chauffage, eau et évacuations." TextWrapping="Wrap" Opacity="0.7" />
          <Button Content="Nouvel immeuble" Command="{Binding NewDocumentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" />
          <Button Content="Ouvrir…" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="Ouvrir l'exemple" Command="{Binding OpenSampleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBlock Text="RÉCENTS" Classes="caption" Margin="0,10,0,0" />
          <ItemsControl ItemsSource="{Binding RecentFiles}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
              <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}" />
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <vm:PlanView x:Name="Plan" IsVisible="{Binding IsPlan}" />
      <vm:ElevationView x:Name="Elev" IsVisible="{Binding IsElevation}" Focusable="True" />
      <Grid x:Name="View3DHost" IsVisible="{Binding Is3D}" />
    </Grid>
  </DockPanel>
</Window>
