<Window xmlns:vm="using:ImmoCad.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImmoCad.Desktop.ExportDialog" vm:L.Title="export.title" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock vm:L.Text="export.format" FontWeight="SemiBold" />
    <ComboBox x:Name="Formats" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="Purpose" TextWrapping="Wrap" Opacity="0.7" MinHeight="36" />
    <TextBlock vm:L.Text="export.levels" FontWeight="SemiBold" />
    <ItemsControl x:Name="LevelBoxes" />
    <TextBlock vm:L.Text="export.networks" FontWeight="SemiBold" />
    <ItemsControl x:Name="NetworkBoxes" />
    <TextBlock vm:L.Text="export.units" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Spacing="12"><RadioButton x:Name="Mm" vm:L.Content="export.mm" IsChecked="True" GroupName="u" /><RadioButton x:Name="M" vm:L.Content="export.m" GroupName="u" /></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="CancelBtn" vm:L.Content="btn.cancel" IsCancel="True" />
      <Button x:Name="OkBtn" vm:L.Content="export.go" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
