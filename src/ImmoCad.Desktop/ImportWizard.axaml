<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImmoCad.Desktop" x:Class="ImmoCad.Desktop.ImportWizard" x:DataType="vm:ImportWizardViewModel"
        vm:L.Title="wiz.title" Width="1100" Height="740" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Right" Width="300" Padding="16" Background="{DynamicResource SystemChromeLowColor}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="BackBtn" vm:L.Content="wiz.back" Click="OnBack" />
          <Button x:Name="NextBtn" vm:L.Content="wiz.next" Classes="accent" Click="OnNext" />
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock x:Name="Title" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="Help" TextWrapping="Wrap" Opacity="0.75" />

          <StackPanel x:Name="PStraighten" Spacing="8">
            <Button vm:L.Content="wiz.autodeskew" Click="OnAutoDeskew" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding AngleLabel}" />
            <Slider Minimum="-10" Maximum="10" Value="{Binding Angle}" TickFrequency="0.1" PointerReleased="OnAngleChanged" />
          </StackPanel>

          <StackPanel x:Name="PCalibrate" Spacing="8" IsVisible="False">
            <CheckBox vm:L.Content="wiz.twoaxes" IsChecked="{Binding TwoAxes}" />
            <TextBlock vm:L.Text="wiz.dist.h" />
            <NumericUpDown Value="{Binding DistanceMetres}" Minimum="0.1" Maximum="500" Increment="0.1" FormatString="0.00" />
            <StackPanel IsVisible="{Binding TwoAxes}">
              <TextBlock vm:L.Text="wiz.dist.v" />
              <NumericUpDown Value="{Binding DistanceVMetres}" Minimum="0.1" Maximum="500" Increment="0.1" FormatString="0.00" />
            </StackPanel>
            <TextBlock x:Name="CalText" FontWeight="SemiBold" />
          </StackPanel>

          <StackPanel x:Name="PDetect" Spacing="6" IsVisible="False">
            <Button vm:L.Content="wiz.autothick" Click="OnAutoThickness" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding ThresholdLabel}" />
            <Slider Minimum="0" Maximum="255" Value="{Binding Threshold}" PointerReleased="OnDetectParam" />
            <TextBlock Text="{Binding MinThicknessLabel}" />
            <Slider Minimum="1" Maximum="60" Value="{Binding MinThickness}" PointerReleased="OnDetectParam" />
            <TextBlock Text="{Binding BridgeLabel}" />
            <Slider Minimum="0" Maximum="30" Value="{Binding BridgeGap}" PointerReleased="OnDetectParam" />
            <TextBlock Text="{Binding MinAreaLabel}" />
            <Slider Minimum="1" Maximum="2000" Value="{Binding MinArea}" PointerReleased="OnDetectParam" />
            <CheckBox vm:L.Content="wiz.straighten.all" IsChecked="{Binding StraightenWalls}" />
          </StackPanel>

          <StackPanel x:Name="PReview" Spacing="6" IsVisible="False">
            <TextBlock x:Name="ReviewText" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <vm:ImageCanvas x:Name="Canvas" />
  </DockPanel>
</Window>
