<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImmoCad.Desktop" x:Class="ImmoCad.Desktop.ImportWizard" x:DataType="vm:ImportWizardViewModel"
        vm:L.Title="wiz.title" Width="1100" Height="740" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Right" Width="300" Padding="16" Background="{DynamicResource SystemChromeLowColor}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="BackBtn" vm:L.Content="wiz.back" Click="OnBack" />
          <Button x:Name="NextBtn" vm:L.Content="wiz.next" Classes="accent" Click="OnNext" />
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock x:Name="Title" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="Help" TextWrapping="Wrap" Opacity="0.75" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="+" vm:L.Tip="wiz.zoomin" Click="OnZoomIn" Width="34" HorizontalContentAlignment="Center" />
            <Button Content="−" vm:L.Tip="wiz.zoomout" Click="OnZoomOut" Width="34" HorizontalContentAlignment="Center" />
            <Button vm:L.Content="wiz.fit" Click="OnFit" />
          </StackPanel>

          <StackPanel x:Name="PStraighten" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="↺ 90°" vm:L.Tip="wiz.turn.left" Click="OnTurnLeft" />
              <Button Content="↻ 90°" vm:L.Tip="wiz.turn.right" Click="OnTurnRight" />
            </StackPanel>
            <TextBlock Text="{Binding AngleLabel}" />
            <Slider Minimum="-45" Maximum="45" Value="{Binding Angle}" TickFrequency="0.1" PointerReleased="OnAngleChanged" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <RepeatButton Content="−0.1°" vm:L.Tip="wiz.angle.down" Click="OnAngleDown" />
              <RepeatButton Content="+0.1°" vm:L.Tip="wiz.angle.up" Click="OnAngleUp" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="PCalibrate" Spacing="8" IsVisible="False">
            <TextBlock vm:L.Text="wiz.printed" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <TextBlock Text="1 :" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding ScaleDenominator}" Minimum="1" Maximum="100000" Increment="10" FormatString="0" />
            </Grid>
            <Separator />
            <TextBlock vm:L.Text="wiz.measure" TextWrapping="Wrap" />
            <TextBlock vm:L.Text="wiz.dist.h" TextWrapping="Wrap" />
            <NumericUpDown Value="{Binding DistanceMetres}" Minimum="0.1" Maximum="500" Increment="0.05" FormatString="0.00" />
            <TextBlock x:Name="CalText" FontWeight="SemiBold" />
          </StackPanel>

          <StackPanel x:Name="PDetect" Spacing="6" IsVisible="False">
            <Button vm:L.Content="wiz.autothick" Click="OnAutoThickness" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding ThresholdLabel}" />
            <Slider Minimum="0" Maximum="255" Value="{Binding Threshold}" />
            <TextBlock Text="{Binding MinThicknessLabel}" />
            <Slider Minimum="1" Maximum="60" Value="{Binding MinThickness}" />
            <TextBlock Text="{Binding BridgeLabel}" />
            <Slider Minimum="0" Maximum="30" Value="{Binding BridgeGap}" />
            <TextBlock Text="{Binding MinAreaLabel}" />
            <Slider Minimum="1" Maximum="2000" Value="{Binding MinArea}" />
            <CheckBox vm:L.Content="wiz.straighten.all" IsChecked="{Binding StraightenWalls}" />
            <CheckBox vm:L.Content="wiz.thin" vm:L.Tip="wiz.thin.tip" IsChecked="{Binding ThinToMarkings}" />
            <NumericUpDown Value="{Binding ThinMarkingMm}" Minimum="20" Maximum="1000" Increment="10" vm:L.Format="fmt.thinmax" IsEnabled="{Binding ThinToMarkings}" />
          </StackPanel>

          <StackPanel x:Name="PReview" Spacing="6" IsVisible="False">
            <TextBlock x:Name="ReviewText" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <vm:ImageCanvas x:Name="Canvas" />
  </DockPanel>
</Window>
