<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ImmoCad.Desktop.App" Name="ImmoCad" RequestedThemeVariant="Default">
  <!-- macOS application menu: the app name above replaces "Avalonia Application", this About replaces "About Avalonia" (header set in code, translated). -->
  <NativeMenu.Menu><NativeMenu><NativeMenuItem Click="OnAbout" /></NativeMenu></NativeMenu.Menu>
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://ImmoCad/Themes/Tokens.axaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Application.Resources>
  <Application.Styles><FluentTheme /></Application.Styles>
</Application>
