<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImmoCad.Desktop"
        x:Class="ImmoCad.Desktop.MainWindow" x:DataType="vm:MainViewModel"
        Icon="avares://ImmoCad/Assets/icon.png" Title="{Binding Title}" Width="1280" Height="820" MinWidth="800" MinHeight="500">
  <Window.Styles>
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button.level">
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,3" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.level.current"><Setter Property="Background" Value="{DynamicResource SystemAccentColor}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="26" /></Style>
    <Style Selector="Border.bar"><Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Opacity" Value="0.65" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Button.step"><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="10,5" /></Style>
    <Style Selector="Button.step.current"><Setter Property="Background" Value="{DynamicResource SystemAccentColor}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Border.stepnum"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="CornerRadius" Value="10" /><Setter Property="BorderThickness" Value="1.5" /><Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}" /></Style>
    <Style Selector="Button.step.current Border.stepnum"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="White" /></Style>
    <Style Selector="Button.step.current Border.stepnum TextBlock"><Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" /></Style>
    <Style Selector="Button.step.done Border.stepnum"><Setter Property="Background" Value="#E3F4EA" /><Setter Property="BorderBrush" Value="#E3F4EA" /></Style>
    <Style Selector="Button.step.done Border.stepnum TextBlock"><Setter Property="Foreground" Value="#1F7A4D" /></Style>
    <Style Selector="Border.overlay"><Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}" /><Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 6 20 0 #30000000" /></Style>
  </Window.Styles>
  <DockPanel>
    <ContentControl x:Name="MenuHost" DockPanel.Dock="Top" />
    <!-- document tabs -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="8,4,8,0" IsVisible="{Binding HasDocument}">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabItem">
            <Border CornerRadius="6,6,0,0" Padding="10,5,4,5" Classes.active="{Binding IsActive}" Background="{DynamicResource SystemChromeMediumColor}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Padding="0" Background="Transparent" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SwitchTabCommand}" CommandParameter="{Binding Index}">
                  <TextBlock Text="{Binding Title}" FontWeight="{Binding IsActive, Converter={x:Static vm:Converters.BoldIf}}" />
                </Button>
                <TextBlock Text="●" IsVisible="{Binding IsDirty}" FontSize="9" VerticalAlignment="Center" Foreground="OrangeRed" />
                <Button Content="✕" Padding="4,0" FontSize="10" Background="Transparent" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding Index}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- guided path: the five steps, the next step, expert mode and the action search -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="12,6" IsVisible="{Binding HasDocument}" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding OpenCommandPaletteCommand}" vm:L.Tip="cmd.search" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="⌕" /><TextBlock vm:L.Text="cmd.search" Opacity="0.75" /><TextBlock Text="⌘K" FontSize="11" Opacity="0.55" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StepItem">
              <Button Classes="step" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsDone}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetStepCommand}" CommandParameter="{Binding Key}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="stepnum"><TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
          <CheckBox vm:L.Content="expert.mode" vm:L.Tip="tip.expert" IsChecked="{Binding ExpertMode}" />
          <Button Content="{Binding NextStepLabel}" IsVisible="{Binding HasNextStep}" Command="{Binding NextStepCommand}" Classes="accent" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Classes="bar" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding Hint}" Classes="caption" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding SpaceBusy}" Width="120" MinHeight="4" Margin="0,0,12,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- tool strip -->
    <Border DockPanel.Dock="Left" Classes="bar" Padding="8,8,4,8" IsVisible="{Binding NotWalk}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,0">
        <ToggleButton Classes="tool" Content="↖" vm:L.Tip="tip.select" IsChecked="{Binding IsSelectTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Select" />
        <ToggleButton Classes="tool" Content="▭" vm:L.Tip="tip.drawwall" IsChecked="{Binding IsDrawTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="DrawWall" IsVisible="{Binding ShowWallTools}" />
        <ToggleButton Classes="tool" Content="◎" vm:L.Tip="tip.riser" IsChecked="{Binding IsRiserTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Riser" IsVisible="{Binding ShowRiserTool}" />
        <ToggleButton Classes="tool" Content="╋" vm:L.Tip="tip.pipe" IsChecked="{Binding IsPipeTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="DrawPipe" IsVisible="{Binding ShowPipeTool}" />
        <ToggleButton Classes="tool" Content="⌷" vm:L.Tip="tip.door" IsChecked="{Binding IsDoorTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Door" IsVisible="{Binding ShowRoomTools}" />
        <ToggleButton Classes="tool" Content="⊟" vm:L.Tip="tip.window" IsChecked="{Binding IsWindowTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Window" IsVisible="{Binding ShowRoomTools}" />
        <ToggleButton Classes="tool" Content="▢" vm:L.Tip="tip.space" IsChecked="{Binding IsSpaceTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Space" IsVisible="{Binding ShowRoomTools}" />
        <ToggleButton Classes="tool" Content="№" vm:L.Tip="tip.number" IsChecked="{Binding IsNumberTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="NumberCellars" IsVisible="{Binding ShowRoomTools}" />
        <ToggleButton Classes="tool" vm:L.Tip="tip.measure" IsChecked="{Binding IsMeasureTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Measure">
          <Path Width="26" Height="26" Stretch="Uniform" RenderTransformOrigin="50%,50%" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stroke="{Binding $parent[ToggleButton].Foreground}"
                Data="M1,8 L23,8 L23,16 L1,16 Z M4,8 L4,12 M7,8 L7,10.5 M10,8 L10,12 M13,8 L13,10.5 M16,8 L16,12 M19,8 L19,10.5"><Path.RenderTransform><RotateTransform Angle="-35" /></Path.RenderTransform></Path>
        </ToggleButton>
        <ToggleButton Classes="tool" Content="⧉" vm:L.Tip="tip.mergeregion" IsChecked="{Binding IsMergeRegionTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="MergeRegion" IsVisible="{Binding ShowWallTools}" />
        <ToggleButton Classes="tool" Content="░" vm:L.Tip="tip.paintzone" IsChecked="{Binding IsPaintTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="PaintZone" IsVisible="{Binding ShowWallTools}" />
        <ToggleButton Classes="tool" Content="✂" vm:L.Tip="tip.cutwalls" IsChecked="{Binding IsCutWallTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="CutWall" IsVisible="{Binding ShowWallTools}" />
        <ToggleButton Classes="tool" Content="⟋" vm:L.Tip="tip.straighten" IsChecked="{Binding IsStraightenTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Straighten" IsVisible="{Binding ShowWallTools}" />
        <ToggleButton Classes="tool" Content="⇔" vm:L.Tip="tip.stretch" IsChecked="{Binding IsStretchTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Stretch" IsVisible="{Binding ShowPlanTools}" />
        <ToggleButton Classes="tool" Content="⌖" vm:L.Tip="tip.align" IsChecked="{Binding IsAlignTool, Mode=OneWay}" Command="{Binding SetToolCommand}" CommandParameter="Align" IsVisible="{Binding ShowPlanTools}" />
        <StackPanel IsVisible="{Binding ShowExpertActions}">
          <Separator Margin="0,6" />
          <Button Classes="tool" Content="⤒" vm:L.Tip="tip.moveup" Command="{Binding MoveSelectionUpCommand}" />
          <Button Classes="tool" Content="⤓" vm:L.Tip="tip.movedown" Command="{Binding MoveSelectionDownCommand}" />
          <Button Classes="tool" Content="⧉" vm:L.Tip="tip.copysel" Command="{Binding CopySelectionToAllLevelsCommand}" />
          <Button Classes="tool" Content="✕" vm:L.Tip="tip.delete" Command="{Binding DeleteSelectionCommand}" />
        </StackPanel>
      </StackPanel></ScrollViewer>
    </Border>

    <!-- side panels -->
    <Border DockPanel.Dock="Left" Classes="bar" Width="270" Padding="8" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1,0,0,0">
      <DockPanel>
      <!-- what is selected, and what can be done with it (above the tabs, so the canvas never moves) -->
      <Border x:Name="ActionBar" DockPanel.Dock="Top" Classes="overlay" IsVisible="{Binding ShowSelectionActions}" Padding="8" Margin="0,0,0,8" BoxShadow="0 0 0 0 Transparent">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="4" LineSpacing="4">
            <Button vm:L.Content="bar.rotate" Command="{Binding RotateSelectedEquipmentCommand}" IsVisible="{Binding EquipmentSelected}" />
            <Button vm:L.Content="bar.duplicate" Command="{Binding DuplicateCommand}" IsVisible="{Binding WallsSelected}" />
            <Button vm:L.Content="bar.tomarking" vm:L.Tip="tip.tomarking" Command="{Binding ConvertSelectionToMarkingsCommand}" IsVisible="{Binding WallsSelected}" />
            <Button vm:L.Content="bar.copylevels" Command="{Binding CopySelectionToAllLevelsCommand}" IsVisible="{Binding WallsSelected}" />
            <Button vm:L.Content="bar.elevation" Command="{Binding ShowElevationCommand}" IsVisible="{Binding WallsSelected}" />
            <Button vm:L.Content="bar.properties" Command="{Binding ShowPropertiesCommand}" />
            <Button vm:L.Content="bar.delete" Command="{Binding DeleteSelectionCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TabControl SelectedIndex="{Binding PanelTab}">
        <TabItem vm:L.Header="tab.palette" IsVisible="{Binding NotWalk}">
          <DockPanel>
            <TextBox DockPanel.Dock="Top" vm:L.Watermark="wm.search" Text="{Binding Search}" Margin="0,4,0,6" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Palette}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteItem">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4" Padding="8,8" CornerRadius="8"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectPaletteCommand}" CommandParameter="{Binding Id}">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <vm:SymbolIcon CatalogId="{Binding Id}" Width="56" Height="44" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11.5" Opacity="0.75" />
                          <TextBlock Text="{Binding Category}" Classes="caption" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem vm:L.Header="tab.options" IsVisible="{Binding NotWalk}">
          <ScrollViewer><StackPanel Spacing="6" Margin="0,6">
            <TextBlock vm:L.Text="opt.none" Classes="caption" IsVisible="{Binding HasNoToolOptions}" />
            <StackPanel Spacing="6" IsVisible="{Binding IsDrawTool}">
              <TextBlock vm:L.Text="opt.wall" Classes="caption" />
              <NumericUpDown Value="{Binding WallThicknessMm}" Minimum="20" Maximum="1000" Increment="10" vm:L.Format="fmt.thickness" />
              <TextBlock vm:L.Text="opt.wall.side" Classes="caption" />
              <Button Content="{Binding WallAlignLabel}" Command="{Binding CycleWallAlignOptionCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsRiserTool}">
            <TextBlock vm:L.Text="opt.riser" Classes="caption" />
            <ComboBox ItemsSource="{Binding RiserTemplates}" SelectedItem="{Binding RiserTemplate}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding, Converter={x:Static vm:Converters.Loc}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <ComboBox ItemsSource="{Binding NetworkTypes}" SelectedItem="{Binding RiserType}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="14" Height="14" Fill="{Binding, Converter={x:Static vm:Converters.NetworkBrush}}" Stroke="#66000000" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Text="{Binding, Converter={x:Static vm:Converters.EnumName}}" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <NumericUpDown Value="{Binding RiserDiameter}" Minimum="8" Maximum="200" vm:L.Format="fmt.mm" />
            <NumericUpDown Value="{Binding RiserSpacing}" Minimum="50" Maximum="1000" vm:L.Format="fmt.spacing" />
            <CheckBox vm:L.Content="site.wholebuilding" IsChecked="{Binding RiserWholeBuilding}" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsAlignTool}">
              <TextBlock vm:L.Text="opt.align" Classes="caption" />
            <CheckBox vm:L.Content="align.movewalls" IsChecked="{Binding AlignMoveWalls}" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsPaintTool}">
              <TextBlock vm:L.Text="opt.paint" Classes="caption" />
              <ComboBox ItemsSource="{Binding PaintModes}" SelectedIndex="{Binding PaintMode}" HorizontalAlignment="Stretch" />
              <NumericUpDown Value="{Binding PaintMaxThicknessMm}" Minimum="20" Maximum="1000" Increment="10" vm:L.Format="fmt.thinmax" />
              <CheckBox vm:L.Content="paint.lasso" IsChecked="{Binding PaintLasso}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button vm:L.Content="paint.apply" Command="{Binding PaintApplyCommand}" Classes="accent" />
                <Button vm:L.Content="paint.cancel" Command="{Binding PaintCancelCommand}" />
              </StackPanel>
              <TextBlock vm:L.Text="paint.help" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsSpaceTool}">
              <TextBlock vm:L.Text="opt.space" Classes="caption" />
              <NumericUpDown Value="{Binding SpaceGapMm}" Minimum="0" Maximum="5000" Increment="100" vm:L.Format="fmt.spacegap" />
              <TextBlock vm:L.Text="opt.space.help" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsStraightenTool}">
            <TextBlock vm:L.Text="opt.straighten" Classes="caption" />
            <NumericUpDown Value="{Binding StraightenTolerance}" Minimum="0" Maximum="300" vm:L.Format="fmt.tolerance" />
            <NumericUpDown Value="{Binding StraightenAngle}" Minimum="0" Maximum="20" vm:L.Format="fmt.angle" />
            <Button vm:L.Content="straighten.rect" Command="{Binding MakeRectangularCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsPipeTool}">
            <TextBlock vm:L.Text="opt.pipe" Classes="caption" />
            <ComboBox ItemsSource="{Binding NetworkTypes}" SelectedItem="{Binding PipeType}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="14" Height="14" Fill="{Binding, Converter={x:Static vm:Converters.NetworkBrush}}" Stroke="#66000000" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Text="{Binding, Converter={x:Static vm:Converters.EnumName}}" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <NumericUpDown Value="{Binding PipeDiameter}" Minimum="8" Maximum="200" vm:L.Format="fmt.mm" />
            <NumericUpDown Value="{Binding PipeElevation}" Minimum="0" Maximum="6000" Increment="50" vm:L.Format="fmt.height" />
            </StackPanel>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem vm:L.Header="tab.networks">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Networks}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NetworkItem">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4">
                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Type}" Classes="caption" /><TextBlock Text="{Binding Where}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                    <Button Grid.Column="2" Content="{Binding Visible}" ContentTemplate="{x:Null}" Padding="6,2" vm:L.Tip="tip.togglenet"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleNetworkCommand}" CommandParameter="{Binding Id}" />
                    <Button Grid.Column="3" Content="{Binding Locked}" Padding="6,2" Margin="4,0,0,0" vm:L.Tip="tip.lock"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).LockNetworkCommand}" CommandParameter="{Binding Id}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem vm:L.Header="tab.history">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding HistoryRows}" Margin="0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,2" Background="Transparent"
                          Opacity="{Binding IsFuture, Converter={x:Static vm:Converters.DimIf}}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).JumpToCommand}" CommandParameter="{Binding Index}">
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding IsCurrent, Converter={x:Static vm:Converters.BoldIf}}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem vm:L.Header="tab.site">
          <ScrollViewer><StackPanel Spacing="6" Margin="0,6">
            <TextBox vm:L.Watermark="wm.address" Text="{Binding SiteAddress}" />
            <Button vm:L.Content="site.search" Command="{Binding SearchAddressCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ComboBox ItemsSource="{Binding MapLayers}" SelectedIndex="{Binding MapLayer}" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding SiteMessage}" TextWrapping="Wrap" Classes="caption" />
            <TextBlock vm:L.Text="site.buildings" Classes="caption" />
            <ItemsControl ItemsSource="{Binding FootprintItems}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FootprintItem">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Padding="8,3" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PickFootprintCommand}" CommandParameter="{Binding Index}">
                  <TextBlock Text="{Binding Text}" /></Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button vm:L.Content="site.create" Command="{Binding CreateFromFootprintCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button vm:L.Content="site.parcel.add" Command="{Binding AddParcelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button vm:L.Content="site.parcel.remove" Command="{Binding RemoveParcelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button vm:L.Content="site.place" Command="{Binding BeginPlacementCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <StackPanel Spacing="6" IsVisible="{Binding Placing}">
              <TextBlock vm:L.Text="site.place.rotate" Classes="caption" />
              <WrapPanel>
                <Button Content="↺ 90°" Command="{Binding RotatePlacementCommand}" CommandParameter="90" Margin="0,0,4,4" />
                <Button Content="↻ 90°" Command="{Binding RotatePlacementCommand}" CommandParameter="-90" Margin="0,0,4,4" />
                <RepeatButton Content="↺ 1°" Command="{Binding RotatePlacementCommand}" CommandParameter="1" Margin="0,0,4,4" />
                <RepeatButton Content="↻ 1°" Command="{Binding RotatePlacementCommand}" CommandParameter="-1" Margin="0,0,4,4" />
                <RepeatButton Content="↺ 0.1°" Command="{Binding RotatePlacementCommand}" CommandParameter="0.1" Margin="0,0,4,4" />
                <RepeatButton Content="↻ 0.1°" Command="{Binding RotatePlacementCommand}" CommandParameter="-0.1" Margin="0,0,4,4" />
              </WrapPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button vm:L.Content="site.place.cancel" Command="{Binding CancelPlacementCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" vm:L.Content="site.place.ok" Command="{Binding ConfirmPlacementCommand}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </Grid>
            </StackPanel>
            <Separator />
            <TextBlock vm:L.Text="site.checks" Classes="caption" />
            <CheckBox vm:L.Content="site.showfootprint" IsChecked="{Binding ShowFootprint}" />
            <CheckBox vm:L.Content="site.straighten.cadastre" IsChecked="{Binding StraightenWithCadastre}" />
            <Button vm:L.Content="site.fitwalls" Command="{Binding FitOuterWallsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <TextBlock vm:L.Text="site.guide" TextWrapping="Wrap" Classes="caption" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem vm:L.Header="tab.spaces">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,6">
              <TextBlock vm:L.Text="cellar.numbering" Classes="caption" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox Text="{Binding CellarPrefix}" /><NumericUpDown Grid.Column="1" Value="{Binding CellarStart}" Minimum="0" Width="100" /></Grid>
              <ComboBox ItemsSource="{Binding SpaceKinds}" SelectedItem="{Binding NewSpaceKind}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding, Converter={x:Static vm:Converters.EnumName}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding SpaceItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpaceItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Background="Transparent"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FocusSpaceCommand}" CommandParameter="{Binding Id}">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Kind}" Classes="caption" /></StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Area}" VerticalAlignment="Center" Classes="caption" /></Grid>
                      </Button>
                      <Button Grid.Column="1" vm:L.Content="walk.space" Margin="4,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).CanWalk}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).WalkFromSpaceCommand}" CommandParameter="{Binding Id}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem vm:L.Header="tab.properties">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="6" Margin="0,6,10,6">
            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" />
            <!-- each section only when it concerns the selection (all of them in expert mode) -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowWallProps}">
              <TextBox vm:L.Watermark="wm.label" Text="{Binding PropLabel}" />
              <NumericUpDown Value="{Binding PropHeight}" Minimum="0" Maximum="10000" Increment="50" vm:L.Format="fmt.height.level" />
              <Button vm:L.Content="btn.apply" Command="{Binding ApplyPropertiesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <NumericUpDown Value="{Binding PropThickness}" Minimum="0" Maximum="1000" Increment="10" vm:L.Format="fmt.thickness" />
              <Button vm:L.Content="prop.apply.thickness" Command="{Binding ApplyThicknessCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Separator />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding SelectedSpaceVisible}">
              <TextBlock vm:L.Text="space.title" Classes="caption" />
              <TextBox vm:L.Watermark="wm.space.name" Text="{Binding SpaceName}" />
              <ComboBox ItemsSource="{Binding SpaceKinds}" SelectedItem="{Binding SpaceKind}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding, Converter={x:Static vm:Converters.EnumName}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBox vm:L.Watermark="wm.space.number" Text="{Binding SpaceNumber}" />
              <TextBox vm:L.Watermark="wm.space.lot" Text="{Binding SpaceLot}" />
              <Button vm:L.Content="btn.apply" Command="{Binding ApplySpaceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
            <Separator IsVisible="{Binding SelectedSpaceVisible}" />
            <StackPanel Spacing="6" IsVisible="{Binding SelectedOpeningVisible}">
              <TextBlock vm:L.Text="opening.title" Classes="caption" />
              <TextBox vm:L.Watermark="wm.label" Text="{Binding OpLabel}" />
              <NumericUpDown Value="{Binding OpWidth}" Minimum="100" Maximum="6000" Increment="50" vm:L.Format="fmt.op.width" />
              <NumericUpDown Value="{Binding OpHeight}" Minimum="100" Maximum="4000" Increment="50" vm:L.Format="fmt.op.height" />
              <NumericUpDown Value="{Binding OpSill}" Minimum="0" Maximum="3000" Increment="50" vm:L.Format="fmt.op.sill" />
              <CheckBox vm:L.Content="op.swingleft" IsChecked="{Binding OpSwingLeft}" />
              <CheckBox vm:L.Content="op.swingout" IsChecked="{Binding OpSwingOut}" />
              <Button vm:L.Content="btn.apply" Command="{Binding ApplyOpeningCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding ShowPipeProps}">
              <TextBlock vm:L.Text="ptype.title" Classes="caption" />
              <ComboBox ItemsSource="{Binding NetworkTypes}" SelectedItem="{Binding SegType}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="14" Height="14" Fill="{Binding, Converter={x:Static vm:Converters.NetworkBrush}}" Stroke="#66000000" StrokeThickness="1" VerticalAlignment="Center" /><TextBlock Text="{Binding, Converter={x:Static vm:Converters.EnumName}}" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Button vm:L.Content="ptype.apply" Command="{Binding ApplyPipeTypeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock vm:L.Text="diam.title" Classes="caption" />
              <NumericUpDown Value="{Binding SegDiameter}" Minimum="8" Maximum="200" vm:L.Format="fmt.mm" />
              <Button vm:L.Content="diam.apply" Command="{Binding ApplyDiameterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock vm:L.Text="extent.title" Classes="caption" />
              <TextBlock Text="{Binding ExtentInfo}" Classes="caption" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6"><ComboBox ItemsSource="{Binding LevelNames}" SelectedIndex="{Binding ExtentFrom}" HorizontalAlignment="Stretch" /><ComboBox Grid.Column="1" ItemsSource="{Binding LevelNames}" SelectedIndex="{Binding ExtentTo}" HorizontalAlignment="Stretch" /></Grid>
              <Button vm:L.Content="extent.apply" Command="{Binding ApplyExtentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Separator />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding ShowEquipmentProps}">
            <TextBlock vm:L.Text="eq.title" Classes="caption" />
            <TextBlock Text="{Binding EqInfo}" TextWrapping="Wrap" Classes="caption" />
            <TextBox vm:L.Watermark="wm.label.eq" Text="{Binding EqLabel}" />
            <NumericUpDown Value="{Binding EqWidth}" Minimum="50" Maximum="4000" Increment="50" vm:L.Format="fmt.width" />
            <NumericUpDown Value="{Binding EqDepth}" Minimum="50" Maximum="2000" Increment="10" vm:L.Format="fmt.depth" />
            <NumericUpDown Value="{Binding EqHeight}" Minimum="50" Maximum="3000" Increment="50" vm:L.Format="fmt.height" />
            <NumericUpDown Value="{Binding EqElevation}" Minimum="0" Maximum="3000" Increment="50" vm:L.Format="fmt.mounting" />
            <NumericUpDown Value="{Binding EqRotation}" Minimum="0" Maximum="359" Increment="90" vm:L.Format="fmt.rotation" />
            <Button vm:L.Content="eq.apply" Command="{Binding ApplyEquipmentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Separator />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding ShowBackgroundProps}">
            <TextBlock vm:L.Text="bg.title" Classes="caption" />
            <CheckBox vm:L.Content="bg.show" IsChecked="{Binding BgVisible}" />
            <Slider Minimum="0" Maximum="1" Value="{Binding BgOpacity}" vm:L.Tip="tip.opacity" />
            <CheckBox vm:L.Content="bg.difference" IsChecked="{Binding BgDifference}" />
            <NumericUpDown Value="{Binding ImgScaleX}" Increment="0.01" vm:L.Format="fmt.scalex" />
            <NumericUpDown Value="{Binding ImgScaleY}" Increment="0.01" vm:L.Format="fmt.scaley" />
            <NumericUpDown Value="{Binding ImgRotation}" Increment="0.1" vm:L.Format="fmt.rotation3" />
            <NumericUpDown Value="{Binding ImgOffsetX}" Increment="1" vm:L.Format="fmt.offx" />
            <NumericUpDown Value="{Binding ImgOffsetY}" Increment="1" vm:L.Format="fmt.offy" />
            <Button vm:L.Content="bg.apply" Command="{Binding ApplyImageFieldsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Separator />
            </StackPanel>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      </DockPanel>
    </Border>

    <!-- level bar: scrolls, so 30+ levels fit -->
    <Border DockPanel.Dock="Right" Classes="bar" Width="132" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" vm:L.Text="levelbar.title" Classes="caption" Margin="0,0,0,6" />
        <Button DockPanel.Dock="Bottom" vm:L.Content="level.add" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0" Command="{Binding AddLevelCommand}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LevelItem">
                <Button Classes="level" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Tooltip}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectLevelCommand}" CommandParameter="{Binding Id}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem vm:L.Header="menu.level.addabove" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddLevelAboveCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem vm:L.Header="menu.level.addbelow" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddLevelBelowCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem vm:L.Header="menu.level.rename" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RenameLevelCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem vm:L.Header="menu.level.delete" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteLevelCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem vm:L.Header="menu.level.geometry" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelGeometryCommand}" CommandParameter="{Binding Id}" />
                      <MenuItem vm:L.Header="menu.level.kind.basement" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelKindCommand}" CommandParameter="{Binding BasementSpec}" />
                      <MenuItem vm:L.Header="menu.level.kind.ground" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelKindCommand}" CommandParameter="{Binding GroundSpec}" />
                      <MenuItem vm:L.Header="menu.level.kind.standard" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetLevelKindCommand}" CommandParameter="{Binding StandardSpec}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Content="👁" Padding="2,0" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" FontSize="13" vm:L.Tip="tip.levelvisible"
                            Opacity="{Binding Hidden, Converter={x:Static vm:Converters.DimIf}}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleLevelVisibilityCommand}" CommandParameter="{Binding Id}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Altitude}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- view switch (fixed height: the side-view controls must not resize the canvas) -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="12,6" Height="46">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="↶" Command="{Binding UndoCommand}" vm:L.Tip="tip.undo" />
          <Button Content="↷" Command="{Binding RedoCommand}" vm:L.Tip="tip.redo" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding SelectionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="caption" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button vm:L.Content="view.2d" Command="{Binding SetViewPlaneCommand}" CommandParameter="XY" vm:L.Tip="tip.side.xy" />
          <ToggleButton Content="⫴" vm:L.Tip="tip.sidebyside" IsChecked="{Binding SideBySide}" />
          <Button vm:L.Content="view.elevation" Command="{Binding ShowElevationCommand}" vm:L.Tip="tip.elevation" />
          <Button Content="{Binding WallDisplayLabel}" Command="{Binding CycleWallDisplayCommand}" vm:L.Tip="tip.walldisplay" />
          <ToggleButton vm:L.Content="view.levelonly" IsChecked="{Binding ElevationLevelOnly}" IsVisible="{Binding ShowSideControls}" vm:L.Tip="tip.levelonly" />
          <NumericUpDown Value="{Binding ElevationDepth}" Minimum="0" Maximum="50000" Increment="100" Width="200" vm:L.Format="fmt.depth.pipes" IsVisible="{Binding ShowSideControls}" />
          <Button vm:L.Content="view.3d" Command="{Binding SetModeCommand}" CommandParameter="Solid" />
          <Button vm:L.Content="view.wire" Command="{Binding SetModeCommand}" CommandParameter="Wireframe" />
          <Button vm:L.Content="view.walk" Command="{Binding WalkCommand}" ToolTip.Tip="{Binding WalkTip}" />
          <ToggleButton vm:L.Content="view.xray" IsChecked="{Binding XRay, Mode=OneWay}" Command="{Binding ToggleXRayCommand}" IsVisible="{Binding Is3D}" />
          <ToggleButton vm:L.Content="view.cut" IsChecked="{Binding CutAbove, Mode=OneWay}" Command="{Binding ToggleCutCommand}" IsVisible="{Binding Is3D}" vm:L.Tip="tip.cut" />
          <Button vm:L.Content="view.levels" Command="{Binding CycleLevelFilterCommand}" IsVisible="{Binding Is3D}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Border x:Name="Welcome" ZIndex="10" IsVisible="{Binding ShowWelcome}" Background="{DynamicResource SystemRegionColor}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="360">
          <TextBlock vm:L.Text="app.name" FontSize="34" FontWeight="Light" />
          <TextBlock vm:L.Text="welcome.tagline" TextWrapping="Wrap" Opacity="0.7" />
          <Button vm:L.Content="welcome.new" Command="{Binding NewDocumentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" />
          <Button vm:L.Content="welcome.open" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button vm:L.Content="welcome.sample" Command="{Binding OpenSampleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBlock vm:L.Text="welcome.recent" Classes="caption" Margin="0,10,0,0" />
          <ItemsControl ItemsSource="{Binding RecentFiles}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
              <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}" />
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border ZIndex="20" IsVisible="{Binding TourActive}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Padding="18,14" CornerRadius="10" MaxWidth="560"
              Background="{DynamicResource SystemChromeMediumColor}" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="2">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding TourTitle}" FontSize="17" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding TourProgress}" Opacity="0.6" /></Grid>
          <TextBlock Text="{Binding TourBody}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button vm:L.Content="tour.skip" Command="{Binding TourSkipCommand}" /><Button vm:L.Content="wiz.next" Classes="accent" Command="{Binding TourNextCommand}" /></StackPanel>
        </StackPanel>
      </Border>
      <Border ZIndex="30" IsVisible="{Binding CommandPaletteOpen}" Background="#33000000" PointerPressed="OnPaletteBackdrop">
        <Border Classes="overlay" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Padding="0" PointerPressed="OnPaletteInside">
          <DockPanel>
            <TextBox x:Name="CommandBox" DockPanel.Dock="Top" Text="{Binding CommandQuery}" vm:L.Watermark="cmd.watermark" Margin="8" FontSize="15" KeyDown="OnCommandKey" />
            <TextBlock DockPanel.Dock="Bottom" vm:L.Text="cmd.keys" Classes="caption" Margin="14,6,14,10" />
            <ListBox x:Name="CommandList" ItemsSource="{Binding CommandResults}" SelectedIndex="{Binding CommandIndex}" MaxHeight="420" Background="Transparent" Margin="6,0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CommandEntry">
                  <Grid ColumnDefinitions="*,Auto" Background="Transparent" Tapped="OnCommandTapped">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Group}" Classes="caption" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Border>
      <UniformGrid Rows="1">
        <Grid IsVisible="{Binding ShowPlan}">
          <vm:PlanView x:Name="Plan" />
          <vm:ViewCube x:Name="Cube2D" Width="140" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>
        <Grid x:Name="View3DHost" IsVisible="{Binding Show3D}" />
      </UniformGrid>
      <vm:SiteView x:Name="SiteMap" IsVisible="{Binding IsSite}" />
      <vm:ElevationView x:Name="Elev" IsVisible="{Binding IsElevation}" Focusable="True" />
    </Grid>
  </DockPanel>
</Window>
